# Copy this file to .env and fill in real values. .env is git-ignored.

# Gemini API key (Phase 3). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name is configurable so it can change without touching code.
GEMINI_MODEL=gemini-2.5-flash

# Optional: sent in the scraper's User-Agent so site owners can reach you.
CONTACT_EMAIL=

# Seconds to wait between requests to the same host (robots.txt Crawl-delay wins if larger).
SCRAPE_DELAY_SECONDS=5
# Seconds between LLM calls (free tier has a requests-per-minute cap).
LLM_DELAY_SECONDS=6
